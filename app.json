{
  "expo": {
    "name": "Owllowance",
    "slug": "owllowance",
    "version": "0.2.0",
    "scheme": "owllowance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.owllowance.app",
      "predictiveBackGestureEnabled": true,
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Owllowance"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F8",
          "dark": {
            "backgroundColor": "#F4F5F8"
          },
          "android": {
            "drawable": {
              "icon": "./assets/motion/native-launch-placeholder.xml"
            }
          }
        }
      ],
      "./plugins/with-native-loading.cjs",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Owllowance uses a photo only when you choose one for a goal.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-release-signing.cjs",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PaymentsDue",
              "label": "Payments due",
              "description": "What is due this week",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickAdd",
              "label": "Add expense",
              "description": "Owl button that adds an expense",
              "minWidth": "57dp",
              "minHeight": "57dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none"
            },
            {
              "name": "Balance",
              "label": "Net worth",
              "description": "Your total, hidden when you hide it in the app",
              "minWidth": "110dp",
              "minHeight": "57dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
