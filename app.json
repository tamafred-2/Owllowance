{
  "expo": {
    "name": "Owllowance",
    "slug": "owllowance",
    "version": "0.2.0",
    "scheme": "owllowance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.owllowance.app",
      "predictiveBackGestureEnabled": true,
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Owllowance"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F8",
          "dark": {
            "backgroundColor": "#F4F5F8"
          },
          "android": {
            "drawable": {
              "icon": "./assets/motion/native-launch-placeholder.xml"
            }
          }
        }
      ],
      "./plugins/with-native-loading.cjs",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-release-signing.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
